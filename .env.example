APP_NAME=Polsia AI
APP_ENV=development
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256
JWT_SECRET=change-me-in-your-environment
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-in-your-environment
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/polsia
WEBHOOK_SIGNING_SECRET=change-me-in-your-environment
RATE_LIMIT_PER_MINUTE=60
DEFAULT_TENANT_PLAN=pro
DEFAULT_TENANT_STATUS=active
LOG_LEVEL=INFO
ENABLE_DOCS=true
UPI_QR_URL=https://example.com/upi-qr.png
DEBUG_REVIEW_INTERVAL_SECONDS=60
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_DEFAULT_PROVIDER=mock

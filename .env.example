APP_ENV=development
APP_NAME=Polsia AI
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/polsia
JWT_SECRET=replace-with-secure-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-secure-admin-password
WEBHOOK_SIGNING_SECRET=replace-with-webhook-secret
OPENAI_API_KEY=replace-with-openai-key
REDIS_URL=redis://localhost:6379/0
DEFAULT_UPI_QR_URL=https://example.com/upi-qr.png
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
